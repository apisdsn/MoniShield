# Collector receiver subdomain (DNS only, not behind Cloudflare). Copied into /etc/caddy/generated by entrypoint.sh only
# when DOCKER_INGEST_DOMAIN is set; Caddy requests its own Let's Encrypt certificate for that host.
# No access log is configured, so nothing about the requests (and never a body) is written.
{$DOCKER_INGEST_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	request_body {
		max_size 10MB   # a little above S4_COLLECTOR_MAX_BODY_MB (default 8)
	}

	@receiver path /api/collector/* /collector/install.sh /collector/install.ps1
	handle @receiver {
		reverse_proxy app:8000 {
			header_up -Cf-Connecting-Ip   # a collector is no Cloudflare edge: never pass this header on
		}
	}
	handle {
		respond 404   # the dashboard is not reachable on this host
	}
}
