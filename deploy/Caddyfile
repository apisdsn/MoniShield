# Optional HTTPS proxy ("proxy" profile, TRD §7.1 ASSUMPTION T5). Certificates are provided by the server owner in
# DOCKER_CERT_DIR (cert.pem + key.pem). Skip this service when the server already has a reverse proxy.
{
	auto_https off
	admin off
}

{$DOCKER_DOMAIN}:443 {
	tls /certs/cert.pem /certs/key.pem
	encode zstd gzip
	reverse_proxy app:8000
}
