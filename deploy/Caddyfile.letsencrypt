# Proxy HTTPS dengan sertifikat OTOMATIS dari Let's Encrypt (profil "https"; docs/07-deploy-vps.md).
# Syarat: DNS DOCKER_DOMAIN sudah mengarah ke IP server ini, dan port 80 + 443 terbuka dari internet
# (port 80 dipakai Let's Encrypt untuk verifikasi dan untuk mengalihkan http -> https).
{
	email {$DOCKER_ACME_EMAIL}
	admin off
}

{$DOCKER_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:8000   # SSE /api/live/map diteruskan langsung (Caddy tidak menahan text/event-stream)
}
