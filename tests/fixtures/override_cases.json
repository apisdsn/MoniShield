[
  {"name": "inserted above the rule that reads the service",
   "rules": [["monishield-https-1", "caddy-json"], ["*", "spring-boot"]],
   "set": ["host1", "portfolio-api-1", "json"],
   "expect": [["monishield-https-1", "caddy-json"], ["host1/portfolio-api-1", "json"], ["*", "spring-boot"]]},
  {"name": "above the first matching rule, not at the top",
   "rules": [["a", "plain"], ["host1/*", "plain"], ["coredns", "coredns"], ["*", "spring-boot"]],
   "set": ["host1", "app-1", "logfmt"],
   "expect": [["a", "plain"], ["host1/app-1", "logfmt"], ["host1/*", "plain"], ["coredns", "coredns"], ["*", "spring-boot"]]},
  {"name": "choosing it again edits the same rule",
   "rules": [["host1/app-1", "logfmt"], ["*", "spring-boot"]],
   "set": ["host1", "app-1", "json"],
   "expect": [["host1/app-1", "json"], ["*", "spring-boot"]]},
  {"name": "the format the next rule gives removes the rule",
   "rules": [["host1/app-1", "logfmt"], ["*", "spring-boot"]],
   "set": ["host1", "app-1", "spring-boot"],
   "expect": [["*", "spring-boot"]]},
  {"name": "the format the rule in use already gives changes nothing",
   "rules": [["monishield-https-1", "caddy-json"], ["*", "spring-boot"]],
   "set": ["host1", "monishield-https-1", "caddy-json"],
   "expect": [["monishield-https-1", "caddy-json"], ["*", "spring-boot"]]},
  {"name": "without a namespace the rule is the service name",
   "rules": [["*", "spring-boot"]],
   "set": [null, "worker", "syslog"],
   "expect": [["worker", "syslog"], ["*", "spring-boot"]]}
]
