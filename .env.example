# =====================================================================================================
#  MoniShield (v2, dashboard log SIMPeL4) — contoh konfigurasi. LENGKAP: semua variabel yang dikenal aplikasi ada di sini.
# =====================================================================================================
#  Cara pakai:   cp .env.example .env && chmod 600 .env    lalu isi bagian [WAJIB].
#  .env TIDAK masuk git dan TIDAK masuk image Docker. Jangan kirim isinya lewat chat/email.
#
#  Penanda:  [WAJIB]           harus diisi, aplikasi tidak bisa dipakai tanpanya
#            [WAJIB DOCKER]    harus diisi bila menjalankan dengan `docker compose`
#            [DISARANKAN]      boleh kosong, tetapi fitur tertentu tidak jalan (dijelaskan)
#            [OPSIONAL]        baris diawali "#" = memakai nilai bawaan yang tertulis; hapus "#" untuk mengubah
#
#  Aturan penulisan: KEY=nilai, tanpa spasi di sekitar "=". Daftar/kamus ditulis JSON satu baris.
#  Prioritas: variabel lingkungan > .env > config.toml > nilai bawaan.
#  Membuat nilai acak:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================================================


# ----------------------------------------------------------------------------------------------------
# 1. AKUN, SESI, TOKEN                                                                       (RAHASIA)
# ----------------------------------------------------------------------------------------------------
# [WAJIB] Rahasia penanda tangan sesi masuk (JWT). Minimal 32 karakter acak. Mengganti nilainya
#         mengeluarkan semua pengguna yang sedang masuk.
S4_JWT_SECRET=

# [WAJIB] Admin pertama. Hanya dipakai saat belum ada akun sama sekali; sandi minimal 12 karakter dan
#         wajib diganti saat masuk pertama. Setelah itu akun dikelola di layar "Kelola user".
S4_ADMIN_USER=admin
S4_ADMIN_PASSWORD=

# [DISARANKAN] Token mesin (acak, panjang) untuk memicu ingest/impor tanpa login:
#         dipakai `docker compose run --rm ingest`, cron, dan pengirim tautan S3. Kosong = fitur itu mati.
#         Di Docker praktis [WAJIB] karena layanan ingest memakainya.
S4_JOB_TOKEN=

# [OPSIONAL] Lama sesi: keluar otomatis setelah N menit tanpa aktivitas / paling lama N jam.
# S4_SESSION_IDLE_MINUTES=60
# S4_SESSION_MAX_HOURS=12


# ----------------------------------------------------------------------------------------------------
# 2. KHUSUS DOCKER COMPOSE (diabaikan saat jalan tanpa Docker)
# ----------------------------------------------------------------------------------------------------
# [WAJIB DOCKER] Folder log di server (berisi folder YYYY-MM-DD/...). Dipasang hanya-baca ke container.
DOCKER_LOG_DIR=/srv/log-simpel4

# [WAJIB DOCKER] Sandi basis data akun (PostgreSQL di dalam compose). Acak; tidak perlu diingat.
POSTGRES_PASSWORD=

# [OPSIONAL] Port dashboard di host. Hanya terbuka untuk 127.0.0.1 (dipakai reverse proxy server).
# DOCKER_PORT=8000

# [OPSIONAL] Berkas CA tambahan bila server keluar internet lewat proxy yang memeriksa TLS (pip/npm saat build
#            gagal "self-signed certificate in certificate chain"). Hanya dipakai saat build, tidak masuk image.
# DOCKER_BUILD_CA=/etc/ssl/certs/proxy-kantor.pem

# [OPSIONAL] Hanya untuk profil "proxy" (HTTPS di dalam compose, bila server belum punya reverse proxy):
#            nama domain dan folder berisi cert.pem + key.pem.
# DOCKER_DOMAIN=dashboard-simpel4.ombudsman.go.id
# DOCKER_CERT_DIR=/etc/ssl/simpel4


# ----------------------------------------------------------------------------------------------------
# 3. SERVER DAN KEAMANAN COOKIE
# ----------------------------------------------------------------------------------------------------
# [WAJIB] true di server yang dibuka lewat HTTPS. Isi false HANYA untuk mencoba di komputer sendiri
#         lewat http:// (tanpa itu browser tidak menyimpan cookie sesi dan login selalu gagal).
S4_COOKIE_SECURE=true

# [OPSIONAL] Alamat:port server. Docker mengatur sendiri (0.0.0.0:8000 di dalam container).
# S4_BIND=127.0.0.1:8000

# [OPSIONAL] true bila ada reverse proxy di depan (IP klien diambil dari X-Forwarded-For untuk audit dan
#            pembatasan percobaan masuk). Docker mengisi true sendiri.
# S4_TRUST_PROXY=false

# [OPSIONAL] Ingest otomatis saat server mulai (menangkap folder log yang terlewat).
# S4_INGEST_ON_START=true

# [OPSIONAL] Alamat API untuk perintah baris `monishield ingest|import` bila server berjalan di mesin/container
#            lain. Diisi -> perintah tidak pernah membuka database sendiri. Docker mengisi sendiri.
# S4_API_URL=


# ----------------------------------------------------------------------------------------------------
# 4. LOKASI FOLDER (jalan tanpa Docker; Docker mengatur sendiri: /logs, /data, /cache, /inbox)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] Folder log (hanya dibaca). Bawaan: folder induk v2/.
# S4_LOG_DIR=/path/ke/folder-log
# [OPSIONAL] Database DuckDB, berkas peta, CSV sementara. Bawaan: v2/data
# S4_DATA_DIR=data
# [OPSIONAL] Unduhan database IP dan peta (±190 MB). Bawaan: <S4_LOG_DIR>/.cache
# S4_CACHE_DIR=/path/ke/.cache
# [OPSIONAL] auth.db (akun, sesi, audit) bila TIDAK memakai PostgreSQL. WAJIB dicadangkan. Bawaan: = S4_DATA_DIR
# S4_STATE_DIR=data
# [OPSIONAL] Folder log hasil impor S3. Bawaan: <S4_DATA_DIR>/inbox
# S4_INBOX_DIR=data/inbox


# ----------------------------------------------------------------------------------------------------
# 5. BASIS DATA AKUN                                                                         (RAHASIA)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] PostgreSQL untuk akun, sesi, audit. Kosong = berkas SQLite auth.db di S4_STATE_DIR (cukup untuk
#            satu server). Docker mengisi sendiri dari POSTGRES_PASSWORD; JANGAN diisi saat memakai Docker.
# S4_AUTH_DATABASE_URL=postgresql+psycopg://simpel4:<sandi>@<host>:5432/simpel4


# ----------------------------------------------------------------------------------------------------
# 6. LOKASI IP DI PETA: MaxMind GeoLite2 (gratis, perlu daftar di maxmind.com)              (RAHASIA)
# ----------------------------------------------------------------------------------------------------
# [DISARANKAN] Tanpa ini peta tetap tampil, tetapi IP baru tidak mendapat kota/koordinat. Pemilik jaringan
#              (ASN) tetap dari ip2asn. IP pengguna TIDAK pernah dikirim ke MaxMind: databasenya diunduh.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# [OPSIONAL] true = jangan mengunduh apa pun (database IP, berkas peta); pakai isi cache yang ada.
# S4_OFFLINE=false


# ----------------------------------------------------------------------------------------------------
# 7. DETEKSI SERANGAN (halaman Keamanan)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] crs = OWASP Core Rule Set + kategori CAPEC; lama = aturan dashboard lama (untuk uji kesetaraan).
#            Cukup mulai ulang server: hasil kedua aturan selalu disimpan, tidak perlu hitung ulang.
# S4_ATTACK_RULES=crs
# [OPSIONAL] Tingkat paranoia CRS 1–4. Naik = lebih banyak tertangkap, lebih banyak salah-tuduh.
#            Ingest berikutnya menghitung ulang semua folder secara otomatis.
# S4_ATTACK_PARANOIA=1


# ----------------------------------------------------------------------------------------------------
# 8. IMPOR DARI S3 (layar "Ingest & impor")                                     (RAHASIA: kunci AWS)
# ----------------------------------------------------------------------------------------------------
# [DISARANKAN bila log diambil dari bucket] Daftar izin bucket -> awalan. {} = impor mati.
S4_IMPORT_BUCKETS={"simpel4-backup": ["k8s-logs/"]}
# [DISARANKAN bila impor dipakai] Kunci akses BACA-SAJA (lihat README: kebijakan IAM). Kosong = impor
#            hanya bisa dengan kredensial yang ditempel admin di layar (hilang saat server dimulai ulang).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# [OPSIONAL] Hanya untuk kredensial sementara (STS).
# AWS_SESSION_TOKEN=
# [OPSIONAL] Wilayah bucket dan batas per impor.
# S4_IMPORT_REGION=ap-southeast-3
# S4_IMPORT_MAX_OBJECTS=500
# S4_IMPORT_MAX_OBJECT_MB=1024
# S4_IMPORT_MAX_TOTAL_MB=5120
# S4_IMPORT_TIMEOUT_MINUTES=30
# [OPSIONAL] true = file .log.gz hasil impor langsung diekstrak menjadi .log di kotak masuk (lebih besar di disk,
#            bisa dibuka editor); false = disimpan apa adanya (.gz tetap terbaca dashboard).
# S4_IMPORT_EXTRACT=true


# ----------------------------------------------------------------------------------------------------
# 9. NILAI LINGKUNGAN SIMPEL4 (dulu ditulis mati di sistem lama; ubah hanya bila infrastrukturnya berubah)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] Titik tujuan di peta = IP publik server (hasil resolve api-simpel4.ombudsman.go.id).
# S4_SERVER_IP=103.170.104.228
# [OPSIONAL] Lokasi titik server bila database IP tidak memberi kota: [kota, wilayah, negara, lintang, bujur].
# S4_SERVER_FALLBACK=["Jakarta", "Jakarta", "ID", -6.2, 106.82]
# [OPSIONAL] DNS upstream yang dipantau di log coredns.
# S4_DNS_UPSTREAM=10.88.1.100
# [OPSIONAL] Awalan nama upstream ingress yang dibuang agar nama modul ringkas.
# S4_UPSTREAM_PREFIX=ombudsman-ombudsman-
# [OPSIONAL] Upstream ingress -> alamat publiknya (untuk menampilkan URL lengkap).
# S4_HOSTS={"om-be-simpel-loop-3000": "https://api-simpel4.ombudsman.go.id", "om-be-appsmanager-3000": "https://appsmanager-simpel4.ombudsman.go.id", "om-be-referensi-3000": "https://reference-simpel4.ombudsman.go.id", "om-be-report-3000": "https://report-simpel4.ombudsman.go.id", "om-fe-inhouse-3000": "https://simpel4.ombudsman.go.id", "cattle-system-rancher-80": "https://rancher-prd.ombudsman.go.id"}
