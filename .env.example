# Salin menjadi .env lalu isi. .env TIDAK masuk git dan tidak masuk image.
# Prioritas: variabel lingkungan > .env > config.toml > nilai bawaan. Baris yang dikomentari = nilai bawaan.
# Daftar dan kamus ditulis sebagai JSON satu baris.

# ---------------------------------------------------------------- lokasi
# S4_LOG_DIR=/path/ke/folder-log          # folder log (dibaca saja); bawaan: folder induk v2/
# S4_DATA_DIR=data                        # DuckDB, berkas peta, CSV sementara
# S4_CACHE_DIR=/path/ke/.cache            # unduhan database IP dan peta; bawaan: <S4_LOG_DIR>/.cache
# S4_STATE_DIR=data                       # auth.db (akun, sesi, audit): wajib dicadangkan
# S4_INBOX_DIR=data/inbox                 # folder log hasil impor S3

# ---------------------------------------------------------------- server
# S4_BIND=127.0.0.1:8000
# S4_INGEST_ON_START=true
# S4_OFFLINE=false                        # true: jangan mengunduh apa pun (database IP, berkas peta)
S4_COOKIE_SECURE=true                     # false HANYA untuk jalan lokal tanpa HTTPS
# S4_TRUST_PROXY=false                    # true bila ada reverse proxy di depan (IP klien dari X-Forwarded-For)
# S4_SESSION_IDLE_MINUTES=60
# S4_SESSION_MAX_HOURS=12

# ---------------------------------------------------------------- akun dan token (RAHASIA)
S4_ADMIN_USER=admin                       # admin pertama; hanya dipakai bila belum ada user
S4_ADMIN_PASSWORD=                        # minimal 12 karakter; wajib diganti saat masuk pertama
S4_JOB_TOKEN=                             # token acak panjang untuk tugas ingest dan pengirim tautan S3
S4_JWT_SECRET=                            # WAJIB: rahasia penanda tangan token sesi (JWT), minimal 32 karakter acak

# ---------------------------------------------------------------- basis data akun: PostgreSQL lewat ORM (RAHASIA)
# Kosong = berkas SQLite di S4_STATE_DIR (hanya untuk uji / jalan lokal tanpa server basis data).
S4_AUTH_DATABASE_URL=                     # postgresql+psycopg://simpel4:<sandi>@postgres:5432/simpel4

# ---------------------------------------------------------------- lokasi IP: MaxMind GeoLite2 (RAHASIA)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ---------------------------------------------------------------- impor S3 (RAHASIA: kunci baca-saja)
S4_IMPORT_BUCKETS={"simpel4-backup": ["k8s-logs/"]}   # daftar izin bucket -> awalan; {} = impor mati
# S4_IMPORT_REGION=ap-southeast-3
# S4_IMPORT_MAX_OBJECTS=500
# S4_IMPORT_MAX_OBJECT_MB=1024
# S4_IMPORT_MAX_TOTAL_MB=5120
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                      # hanya untuk kredensial sementara

# ---------------------------------------------------------------- nilai yang dulu ditulis mati di sistem lama
# S4_SERVER_IP=103.170.104.228            # titik tujuan di peta (IP publik server)
# S4_SERVER_FALLBACK=["Jakarta", "Jakarta", "ID", -6.2, 106.82]
# S4_DNS_UPSTREAM=10.88.1.100
# S4_UPSTREAM_PREFIX=ombudsman-ombudsman-
# S4_HOSTS={"om-be-simpel-loop-3000": "https://api-simpel4.ombudsman.go.id", "om-be-appsmanager-3000": "https://appsmanager-simpel4.ombudsman.go.id", "om-be-referensi-3000": "https://reference-simpel4.ombudsman.go.id", "om-be-report-3000": "https://report-simpel4.ombudsman.go.id", "om-fe-inhouse-3000": "https://simpel4.ombudsman.go.id", "cattle-system-rancher-80": "https://rancher-prd.ombudsman.go.id"}
