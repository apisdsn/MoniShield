# =====================================================================================================
#  MoniShield (v2, dashboard log & keamanan) — contoh konfigurasi. LENGKAP: semua variabel yang dikenal aplikasi ada di sini.
# =====================================================================================================
#  Cara pakai:   cp .env.example .env && chmod 600 .env    lalu isi bagian [WAJIB].
#  .env TIDAK masuk git dan TIDAK masuk image Docker. Jangan kirim isinya lewat chat/email.
#
#  Penanda:  [WAJIB]           harus diisi, aplikasi tidak bisa dipakai tanpanya
#            [WAJIB DOCKER]    harus diisi bila menjalankan dengan `docker compose`
#            [DISARANKAN]      boleh kosong, tetapi fitur tertentu tidak jalan (dijelaskan)
#            [OPSIONAL]        baris diawali "#" = memakai nilai bawaan yang tertulis; hapus "#" untuk mengubah
#
#  Aturan penulisan: KEY=nilai, tanpa spasi di sekitar "=". Daftar/kamus ditulis JSON satu baris.
#  Prioritas: variabel lingkungan > .env > config.toml > nilai bawaan.
#  Layar KONFIGURASI (menu user, admin) MENULIS LANGSUNG KE FILE INI: kredensial AWS/MaxMind, folder S3 otomatis,
#  notifikasi, daftar blokir. Baris yang sudah ada diganti di tempatnya, baris contoh "# KUNCI=" diaktifkan, sisanya
#  ditambahkan di bagian akhir; komentar lain tidak disentuh. Nilai yang diubah dari layar langsung berlaku tanpa mulai
#  ulang. Server harus boleh MENULIS file ini (Docker: sudo chgrp 10001 .env && chmod 660 .env).
#  Membuat nilai acak:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================================================


# ----------------------------------------------------------------------------------------------------
# 1. AKUN, SESI, TOKEN                                                                       (RAHASIA)
# ----------------------------------------------------------------------------------------------------
# [WAJIB] Rahasia penanda tangan sesi masuk (JWT). Minimal 32 karakter acak. Mengganti nilainya
#         mengeluarkan semua pengguna yang sedang masuk.
S4_JWT_SECRET=

# [WAJIB] Admin pertama. Hanya dipakai saat belum ada akun sama sekali; sandi minimal 12 karakter dan
#         wajib diganti saat masuk pertama. Setelah itu akun dikelola di layar "Kelola user".
S4_ADMIN_USER=admin
S4_ADMIN_PASSWORD=

# [DISARANKAN] Token mesin (acak, panjang) untuk memicu ingest/impor tanpa login:
#         dipakai `docker compose run --rm ingest`, cron, dan pengirim tautan S3. Kosong = fitur itu mati.
#         Di Docker praktis [WAJIB] karena layanan ingest memakainya.
S4_JOB_TOKEN=

# [OPSIONAL] Lama sesi: keluar otomatis setelah N menit tanpa aktivitas / paling lama N jam.
# S4_SESSION_IDLE_MINUTES=60
# S4_SESSION_MAX_HOURS=12


# ----------------------------------------------------------------------------------------------------
# 2. KHUSUS DOCKER COMPOSE (diabaikan saat jalan tanpa Docker)
# ----------------------------------------------------------------------------------------------------
# [WAJIB DOCKER] Folder log di server (berisi folder YYYY-MM-DD/...). Dipasang hanya-baca ke container.
DOCKER_LOG_DIR=/srv/log

# [WAJIB DOCKER] Sandi basis data akun (PostgreSQL di dalam compose). Acak; tidak perlu diingat.
POSTGRES_PASSWORD=

# [OPSIONAL, WAJIB bila memakai pgAdmin] Login pgAdmin (docker compose --profile pgadmin up -d) untuk melihat
#            PostgreSQL (akun, sesi, audit, riwayat impor). Terbuka hanya di http://127.0.0.1:5050 server.
#            Email hanya nama login (tidak dikirimi surat); domain .local/.internal/.lan/.test juga diterima.
# PGADMIN_EMAIL=admin@contoh.go.id
# PGADMIN_PASSWORD=
# DOCKER_PGADMIN_PORT=5050

# [OPSIONAL, WAJIB bila memakai DbGate] Login DbGate (docker compose --profile dbgate up -d) untuk melihat DATA LOG
#            (DuckDB, salinan baca yang diperbarui tiap ingest) dan PostgreSQL, keduanya read-only.
#            Terbuka hanya di http://127.0.0.1:5051 server.
# DBGATE_LOGIN=admin
# DBGATE_PASSWORD=
# DOCKER_DBGATE_PORT=5051
# Salinan baca DuckDB untuk DbGate (data/snapshot/monishield.duckdb). Default di docker: true. "false" bila DbGate tidak
# dipakai, untuk menghemat disk (±50 % ukuran monishield.duckdb) dan waktu beberapa detik tiap ingest.
# S4_DUCKDB_SNAPSHOT=true

# [OPSIONAL] Port dashboard di host. Hanya terbuka untuk 127.0.0.1 (dipakai reverse proxy server).
# DOCKER_PORT=8000

# [OPSIONAL] Berkas CA tambahan bila server keluar internet lewat proxy yang memeriksa TLS (pip/npm saat build
#            gagal "self-signed certificate in certificate chain"). Hanya dipakai saat build, tidak masuk image.
# DOCKER_BUILD_CA=/etc/ssl/certs/proxy-kantor.pem

# [OPSIONAL] Hanya untuk profil "proxy" (HTTPS di dalam compose, bila server belum punya reverse proxy):
#            nama domain dan folder berisi cert.pem + key.pem.
# DOCKER_DOMAIN=monishield.contoh.go.id
# DOCKER_CERT_DIR=/etc/ssl/monishield


# ----------------------------------------------------------------------------------------------------
# 3. SERVER DAN KEAMANAN COOKIE
# ----------------------------------------------------------------------------------------------------
# [WAJIB] true di server yang dibuka lewat HTTPS. Isi false HANYA untuk mencoba di komputer sendiri
#         lewat http:// (tanpa itu browser tidak menyimpan cookie sesi dan login selalu gagal).
S4_COOKIE_SECURE=true

# [OPSIONAL] Alamat:port server. Docker mengatur sendiri (0.0.0.0:8000 di dalam container).
# S4_BIND=127.0.0.1:8000

# [OPSIONAL] true bila ada reverse proxy di depan (IP klien diambil dari X-Forwarded-For untuk audit dan
#            pembatasan percobaan masuk). Docker mengisi true sendiri.
# S4_TRUST_PROXY=false

# [OPSIONAL] Ingest otomatis saat server mulai (menangkap folder log yang terlewat).
# S4_INGEST_ON_START=true

# [OPSIONAL] Alamat API untuk perintah baris `monishield ingest|import` bila server berjalan di mesin/container
#            lain. Diisi -> perintah tidak pernah membuka database sendiri. Docker mengisi sendiri.
# S4_API_URL=


# ----------------------------------------------------------------------------------------------------
# 4. LOKASI FOLDER (jalan tanpa Docker; Docker mengatur sendiri: /logs, /data, /cache, /inbox)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] Folder log (hanya dibaca). Bawaan: folder induk v2/.
# S4_LOG_DIR=/path/ke/folder-log
# [OPSIONAL] Database DuckDB, berkas peta, CSV sementara. Bawaan: v2/data
# S4_DATA_DIR=data
# [OPSIONAL] Unduhan database IP dan peta (±190 MB). Bawaan: <S4_LOG_DIR>/.cache
# S4_CACHE_DIR=/path/ke/.cache
# [OPSIONAL] auth.db (akun, sesi, audit) bila TIDAK memakai PostgreSQL. WAJIB dicadangkan. Bawaan: = S4_DATA_DIR
# S4_STATE_DIR=data
# [OPSIONAL] Folder log hasil impor S3. Bawaan: <S4_DATA_DIR>/inbox
# S4_INBOX_DIR=data/inbox


# ----------------------------------------------------------------------------------------------------
# 5. BASIS DATA AKUN                                                                         (RAHASIA)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] PostgreSQL untuk akun, sesi, audit. Kosong = berkas SQLite auth.db di S4_STATE_DIR (cukup untuk
#            satu server). Docker mengisi sendiri dari POSTGRES_PASSWORD; JANGAN diisi saat memakai Docker.
# S4_AUTH_DATABASE_URL=postgresql+psycopg://monishield:<sandi>@<host>:5432/monishield


# ----------------------------------------------------------------------------------------------------
# 6. LOKASI IP DI PETA: MaxMind GeoLite2 (gratis, perlu daftar di maxmind.com)              (RAHASIA)
# ----------------------------------------------------------------------------------------------------
# [DISARANKAN] Tanpa ini peta tetap tampil, tetapi IP baru tidak mendapat kota/koordinat. Pemilik jaringan
#              (ASN) tetap dari ip2asn. IP pengguna TIDAK pernah dikirim ke MaxMind: databasenya diunduh.
#              Bisa juga diisi dari layar Konfigurasi (menu user); isian layar mengalahkan nilai di sini.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# [OPSIONAL] true = jangan mengunduh apa pun (database IP, berkas peta); pakai isi cache yang ada.
# S4_OFFLINE=false


# ----------------------------------------------------------------------------------------------------
# 7. DETEKSI SERANGAN (halaman Keamanan)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] crs = OWASP Core Rule Set + kategori CAPEC; lama = aturan dashboard lama (untuk uji kesetaraan).
#            Cukup mulai ulang server: hasil kedua aturan selalu disimpan, tidak perlu hitung ulang.
# S4_ATTACK_RULES=crs
# [OPSIONAL] Tingkat paranoia CRS 1–4. Naik = lebih banyak tertangkap, lebih banyak salah-tuduh.
#            Ingest berikutnya menghitung ulang semua folder secara otomatis.
# S4_ATTACK_PARANOIA=1
# [OPSIONAL] Daftar blokir (halaman Keamanan → "Daftar blokir…"): IP/CIDR yang TIDAK PERNAH dimasukkan (koma), mis. IP kantor,
#            pemantau uptime, IP publik server sendiri. IP privat selalu dikecualikan.
# S4_BLOCKLIST_EXCLUDE=103.10.20.0/24, 198.51.100.7
# [OPSIONAL] Pemilik jaringan (regex, tidak peka besar/kecil) yang tidak pernah diblokir. Bawaan: OMBUDSMAN.
#            Keduanya juga bisa diisi dari layar Konfigurasi → Daftar blokir (mengalahkan nilai di sini).
# S4_BLOCKLIST_EXCLUDE_ORG=OMBUDSMAN


# ----------------------------------------------------------------------------------------------------
# 8. IMPOR DARI S3 (layar "Ingest & impor")                                     (RAHASIA: kunci AWS)
# ----------------------------------------------------------------------------------------------------
# [DISARANKAN bila log diambil dari bucket] Daftar izin bucket -> awalan (isi dengan bucket log Anda). {} = impor mati.
S4_IMPORT_BUCKETS={"simpel4-backup": ["k8s-logs/"]}
# [DISARANKAN bila impor dipakai] Kunci akses BACA-SAJA (lihat README: kebijakan IAM). Catatan: variabel lingkungan
#            AWS_* yang sudah ada di server/container MENGALAHKAN nilai di file ini.
#            Kosong boleh: isi saja dari layar Konfigurasi (menu user → Konfigurasi → AWS S3; tersimpan di basis data
#            akun, langsung berlaku, mengalahkan nilai di sini), atau tempel kredensial sementara di layar Ingest & impor.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# [OPSIONAL] Hanya untuk kredensial sementara (STS).
# AWS_SESSION_TOKEN=
# [OPSIONAL] Wilayah bucket dan batas per impor.
# S4_IMPORT_REGION=ap-southeast-3
# S4_IMPORT_MAX_OBJECTS=500
# S4_IMPORT_MAX_OBJECT_MB=1024
# S4_IMPORT_MAX_TOTAL_MB=5120
# S4_IMPORT_TIMEOUT_MINUTES=30
# [OPSIONAL] true = file .log.gz hasil impor langsung diekstrak menjadi .log di kotak masuk (lebih besar di disk,
#            bisa dibuka editor); false = disimpan apa adanya (.gz tetap terbaca dashboard).
# S4_IMPORT_EXTRACT=true
# [OPSIONAL] SINKRON OTOMATIS: folder induk S3 yang berisi folder YYYY-MM-DD. Server memeriksanya berkala dan
#            mengambil + meng-ingest folder tanggal yang BARU sendiri, tanpa menempel tautan. Harus termasuk
#            S4_IMPORT_BUCKETS; kunci AWS di atas wajib diisi. Beberapa awalan: pisahkan dengan koma. Kosong = mati.
#            Bisa juga diisi dari layar Konfigurasi / Ingest & impor (ditulis ke baris ini).
# S4_S3_WATCH=s3://nama-bucket/k8s-logs/
# [OPSIONAL] false = sinkron otomatis dimatikan tanpa menghapus alamat di atas (tombol "Matikan" di layar).
# S4_S3_WATCH_ENABLED=true
# [OPSIONAL] Jeda pemeriksaan (menit); 0 = hanya lewat tombol "Periksa S3 sekarang" atau cron.
# S4_S3_WATCH_MINUTES=60
# [OPSIONAL] Hanya folder bertanggal dalam N hari terakhir yang diambil otomatis (0 = seluruh riwayat bucket).
# S4_S3_WATCH_DAYS=30
# [OPSIONAL] Folder baru maksimal per pemeriksaan (terbaru dulu); sisanya menyusul di pemeriksaan berikutnya.
# S4_S3_WATCH_MAX_FOLDERS=3
# [OPSIONAL] Folder hasil sinkron bertanggal >= hari ini - N diperiksa ulang tiap putaran (file yang datang belakangan).
# S4_S3_WATCH_RECHECK_DAYS=1


# ----------------------------------------------------------------------------------------------------
# 8b. NOTIFIKASI: Telegram / Discord / email                             (RAHASIA: token, webhook, sandi SMTP)
# ----------------------------------------------------------------------------------------------------
# Lebih mudah lewat layar Konfigurasi -> Notifikasi (ditulis ke baris-baris ini, ada tombol "Kirim uji"). Server butuh
# akses keluar ke api.telegram.org, discord.com, dan/atau server SMTP. Pesan TIDAK pernah memuat alamat IP.
# [OPSIONAL] Telegram: aktif, token bot (@BotFather), chat ID grup/kanal (mis. -1001234567890).
# S4_ALERT_TELEGRAM=false
# TELEGRAM_BOT_TOKEN=
# S4_ALERT_TELEGRAM_CHAT_ID=
# [OPSIONAL] Discord: aktif, URL webhook kanal (https://discord.com/api/webhooks/…).
# S4_ALERT_DISCORD=false
# DISCORD_WEBHOOK_URL=
# [OPSIONAL] Email lewat SMTP: aktif, server, port, keamanan (starttls | ssl | none), akun, pengirim, penerima (koma).
# S4_ALERT_EMAIL=false
# S4_SMTP_HOST=
# S4_SMTP_PORT=587
# S4_SMTP_SECURITY=starttls
# S4_SMTP_USERNAME=
# SMTP_PASSWORD=
# S4_SMTP_FROM=
# S4_SMTP_TO=
# [OPSIONAL] Kejadian yang dikirim (koma): spike, critical, ingest_failed, sync_failed, folder_missing, summary.
# S4_ALERT_EVENTS=spike,critical,ingest_failed,sync_failed,folder_missing
# [OPSIONAL] Bahasa pesan (id | en), alamat dashboard untuk tautan di pesan, jam (WIB) cek "folder hari ini belum datang".
# S4_ALERT_LANG=id
# S4_DASHBOARD_URL=
# S4_ALERT_MISSING_HOUR=10


# ----------------------------------------------------------------------------------------------------
# 9. NILAI LINGKUNGAN SISTEM YANG DIPANTAU (dulu ditulis mati di sistem lama; ubah hanya bila infrastrukturnya berubah)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] Titik tujuan di peta = IP publik server (hasil resolve api-simpel4.ombudsman.go.id).
# S4_SERVER_IP=103.170.104.228
# [OPSIONAL] Lokasi titik server bila database IP tidak memberi kota: [kota, wilayah, negara, lintang, bujur].
# S4_SERVER_FALLBACK=["Jakarta", "Jakarta", "ID", -6.2, 106.82]
# [OPSIONAL] DNS upstream yang dipantau di log coredns.
# S4_DNS_UPSTREAM=10.88.1.100
# [OPSIONAL] Awalan nama upstream ingress yang dibuang agar nama modul ringkas.
# S4_UPSTREAM_PREFIX=ombudsman-ombudsman-
# [OPSIONAL] Upstream ingress -> alamat publiknya (untuk menampilkan URL lengkap).
# S4_HOSTS={"om-be-simpel-loop-3000": "https://api-simpel4.ombudsman.go.id", "om-be-appsmanager-3000": "https://appsmanager-simpel4.ombudsman.go.id", "om-be-referensi-3000": "https://reference-simpel4.ombudsman.go.id", "om-be-report-3000": "https://report-simpel4.ombudsman.go.id", "om-fe-inhouse-3000": "https://simpel4.ombudsman.go.id", "cattle-system-rancher-80": "https://rancher-prd.ombudsman.go.id"}


# ----------------------------------------------------------------------------------------------------
# 10. ALAMAT LAYANAN LUAR & SUMBER UNDUHAN (dulu tertulis di kode; bawaan = alamat resmi)
# ----------------------------------------------------------------------------------------------------
# [OPSIONAL] Ubah hanya bila server memakai cermin/proxy internal (mis. tanpa akses internet langsung).
#            Yang diunduh hanya berkas data publik; alamat IP pengguna TIDAK pernah dikirim ke alamat-alamat ini.
# [OPSIONAL] MaxMind GeoLite2; "{}" diganti nama edisi (GeoLite2-City-CSV).
# S4_URL_MAXMIND=https://download.maxmind.com/geoip/databases/{}/download?suffix=zip
# [OPSIONAL] Pemilik IP (ASN), iptoasn.com.
# S4_URL_IP2ASN=https://iptoasn.com/data/ip2asn-v4.tsv.gz
# [OPSIONAL] Peta: daratan, batas negara, batas provinsi, label negara (Natural Earth); label wilayah Indonesia (GeoNames).
# S4_URL_LAND=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_land.geojson
# S4_URL_BORDERS=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_admin_0_boundary_lines_land.geojson
# S4_URL_PROVINCES=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_10m_admin_1_states_provinces.geojson
# S4_URL_COUNTRIES=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson
# S4_URL_GEONAMES=https://download.geonames.org/export/dump/ID.zip
# [OPSIONAL] API Telegram (mis. lewat proxy internal).
# S4_TELEGRAM_API=https://api.telegram.org
# [OPSIONAL] Umur maksimal berkas sebelum diunduh ulang (hari). GeoLite2 maks. 30 (lisensi MaxMind).
# S4_GEO_MAX_AGE_DAYS=7
# S4_ASN_MAX_AGE_DAYS=7
# S4_MAP_MAX_AGE_DAYS=3650
# [OPSIONAL] Sesi unggah folder dari browser yang ditinggalkan dibersihkan setelah N jam.
# S4_UPLOAD_SESSION_HOURS=6
