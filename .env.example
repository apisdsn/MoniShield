# =====================================================================================================
#  MoniShield (v2, log & security dashboard) — example configuration. COMPLETE: every variable the application knows is here.
# =====================================================================================================
#  Usage:   cp .env.example .env && chmod 600 .env    then fill in the [REQUIRED] parts.
#  .env is NOT in git and NOT in the Docker image. Do not send its contents via chat/email.
#
#  Markers:  [REQUIRED]          must be set, the application cannot be used without it
#            [REQUIRED DOCKER]   must be set when running with `docker compose`
#            [RECOMMENDED]       may be empty, but certain features do not work (explained)
#            [OPTIONAL]          line starts with "#" = uses the default value shown; remove "#" to change it
#
#  Syntax: KEY=value, no spaces around "=". Lists/dicts are written as single-line JSON.
#  Priority: environment variables > .env > config.toml > defaults.
#  The CONFIGURATION page (user menu, admin) WRITES DIRECTLY TO THIS FILE: AWS/MaxMind credentials, automatic S3 folder,
#  notifications, blocklist. Existing lines are replaced in place, example lines "# KEY=" are activated, the rest are
#  appended at the end; other comments are not touched. Values changed from the page take effect immediately without a
#  restart. The server must be allowed to WRITE this file (Docker: sudo chgrp 10001 .env && chmod 660 .env).
#  Generating a random value:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================================================


# ----------------------------------------------------------------------------------------------------
# 1. ACCOUNTS, SESSIONS, TOKENS                                                              (SECRET)
# ----------------------------------------------------------------------------------------------------
# [REQUIRED] Secret that signs login sessions (JWT). At least 32 random characters. Changing the value
#         logs out every user who is signed in.
S4_JWT_SECRET=

# [REQUIRED] First admin. Only used while there are no accounts at all; password at least 12 characters and
#         must be changed at first login. After that, accounts are managed on the "Manage users" page.
S4_ADMIN_USER=admin
S4_ADMIN_PASSWORD=

# [RECOMMENDED] Machine token (random, long) to trigger ingest/import without logging in:
#         used by `docker compose run --rm ingest`, cron, and S3 link senders. Empty = that feature is off.
#         In Docker effectively [REQUIRED] because the ingest service uses it.
S4_JOB_TOKEN=

# [OPTIONAL] Session length: automatic logout after N minutes of inactivity / at most N hours.
# S4_SESSION_IDLE_MINUTES=60
# S4_SESSION_MAX_HOURS=12


# ----------------------------------------------------------------------------------------------------
# 2. DOCKER COMPOSE ONLY (ignored when running without Docker)
# ----------------------------------------------------------------------------------------------------
# [REQUIRED DOCKER] Log folder on the server (contains YYYY-MM-DD/... folders). Mounted read-only into the container.
DOCKER_LOG_DIR=/srv/log

# [REQUIRED DOCKER] Password of the account database (PostgreSQL inside compose). Random; no need to remember it.
POSTGRES_PASSWORD=

# [OPTIONAL, REQUIRED when using pgAdmin] pgAdmin login (docker compose --profile pgadmin up -d) to view
#            PostgreSQL (accounts, sessions, audit, import history). Open only on the server's http://127.0.0.1:5050.
#            The email is only a login name (no mail is sent to it); .local/.internal/.lan/.test domains are accepted too.
# PGADMIN_EMAIL=admin@contoh.go.id
# PGADMIN_PASSWORD=
# DOCKER_PGADMIN_PORT=5050

# [OPTIONAL, REQUIRED when using DbGate] DbGate login (docker compose --profile dbgate up -d) to view LOG DATA
#            (DuckDB, a read-only copy refreshed on every ingest) and PostgreSQL, both read-only.
#            Open only on the server's http://127.0.0.1:5051.
# DBGATE_LOGIN=admin
# DBGATE_PASSWORD=
# DOCKER_DBGATE_PORT=5051
# [OPTIONAL] Kafka broker bundled with compose (profile "kafka", for logs from Rancher). HOST = this server's address
#            reachable from the cluster nodes (entered in Rancher as HOST:PORT); BIND 0.0.0.0 to be reachable from outside —
#            this listener has NO password, restrict it with a firewall. Message retention in Kafka (hours).
# DOCKER_KAFKA_HOST=127.0.0.1
# DOCKER_KAFKA_BIND=127.0.0.1
# DOCKER_KAFKA_PORT=9094
# DOCKER_KAFKA_RETENTION_HOURS=168
# Read-only DuckDB copy for DbGate (data/snapshot/monishield.duckdb). Default in docker: true. "false" when DbGate is not
# used, to save disk (±50 % of the monishield.duckdb size) and a few seconds on every ingest.
# S4_DUCKDB_SNAPSHOT=true

# [OPTIONAL] Dashboard port on the host. Only open to 127.0.0.1 (used by the server's reverse proxy).
# DOCKER_PORT=8000

# [OPTIONAL] Extra CA file when the server reaches the internet through a TLS-inspecting proxy (pip/npm during the build
#            fail with "self-signed certificate in certificate chain"). Only used during the build, not in the image.
# DOCKER_BUILD_CA=/etc/ssl/certs/proxy-kantor.pem

# [REQUIRED for the "https" / "proxy" profiles] HTTPS inside compose:
#   profile "https" (VPS with a public domain; docs/07-deploy-vps.md): AUTOMATIC Let's Encrypt certificate — set
#            DOCKER_DOMAIN (its DNS already points to the server) + DOCKER_ACME_EMAIL; ports 80 and 443 must be open.
#   profile "proxy" (your own certificate): DOCKER_DOMAIN + a folder containing cert.pem + key.pem.
# DOCKER_DOMAIN=monishield.contoh.go.id
# DOCKER_ACME_EMAIL=admin@contoh.go.id
# DOCKER_CERT_DIR=/etc/ssl/monishield


# ----------------------------------------------------------------------------------------------------
# 3. SERVER AND COOKIE SECURITY
# ----------------------------------------------------------------------------------------------------
# [REQUIRED] true on a server served over HTTPS. Set false ONLY to try it on your own computer
#         over http:// (otherwise the browser does not store the session cookie and login always fails).
S4_COOKIE_SECURE=true

# [OPTIONAL] Server address:port. Docker sets it itself (0.0.0.0:8000 inside the container).
# S4_BIND=127.0.0.1:8000

# [OPTIONAL] true when there is a reverse proxy in front (client IP taken from X-Forwarded-For for audit and
#            login attempt limiting). Docker sets true itself.
# S4_TRUST_PROXY=false

# [OPTIONAL] Automatic ingest when the server starts (catches log folders that were missed).
# S4_INGEST_ON_START=true

# [OPTIONAL] API address for the `monishield ingest|import` commands when the server runs on another machine/container.
#            Set -> the command never opens the database itself. Docker sets it itself.
# S4_API_URL=


# ----------------------------------------------------------------------------------------------------
# 4. FOLDER LOCATIONS (running without Docker; Docker sets them itself: /logs, /data, /cache, /inbox)
# ----------------------------------------------------------------------------------------------------
# [OPTIONAL] Log folder (read only), contains YYYY-MM-DD/<namespace>/<service>/… Default: logs/ in the project folder.
# S4_LOG_DIR=/path/ke/folder-log
# [OPTIONAL] DuckDB database, map files, temporary CSVs. Default: data/ in the project folder
# S4_DATA_DIR=data
# [OPTIONAL] Downloaded IP databases and maps (±190 MB). Default: <S4_LOG_DIR>/.cache
# S4_CACHE_DIR=/path/ke/.cache
# [OPTIONAL] auth.db (accounts, sessions, audit) when NOT using PostgreSQL. MUST be backed up. Default: = S4_DATA_DIR
# S4_STATE_DIR=data
# [OPTIONAL] Folder for logs imported from S3. Default: <S4_DATA_DIR>/inbox
# S4_INBOX_DIR=data/inbox


# ----------------------------------------------------------------------------------------------------
# 5. ACCOUNT DATABASE                                                                        (SECRET)
# ----------------------------------------------------------------------------------------------------
# [OPTIONAL] PostgreSQL for accounts, sessions, audit. Empty = SQLite file auth.db in S4_STATE_DIR (enough for
#            one server). Docker sets it itself from POSTGRES_PASSWORD; do NOT set it when using Docker.
# S4_AUTH_DATABASE_URL=postgresql+psycopg://monishield:<sandi>@<host>:5432/monishield


# ----------------------------------------------------------------------------------------------------
# 6. IP LOCATION ON THE MAP: MaxMind GeoLite2 (free, requires signing up at maxmind.com)     (SECRET)
# ----------------------------------------------------------------------------------------------------
# [RECOMMENDED] Without this the map still shows, but new IPs get no city/coordinates. The network owner
#              (ASN) still comes from ip2asn. User IPs are NEVER sent to MaxMind: the database is downloaded.
#              Can also be set from the Configuration page (user menu); the page's value overrides the value here.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# [OPTIONAL] true = download nothing (IP databases, map files); use what is in the cache.
# S4_OFFLINE=false


# ----------------------------------------------------------------------------------------------------
# 7. ATTACK DETECTION (Security page)
# ----------------------------------------------------------------------------------------------------
# [OPTIONAL] crs = OWASP Core Rule Set + CAPEC categories; lama = the old dashboard's rules (for the equivalence test).
#            A server restart is enough: results of both rule sets are always stored, no recomputation needed.
# S4_ATTACK_RULES=crs
# [OPTIONAL] CRS paranoia level 1–4. Higher = more caught, more false positives.
#            The next ingest recomputes all folders automatically.
# S4_ATTACK_PARANOIA=1
# [OPTIONAL] Blocklist (Security page → "Block list…"): IPs/CIDRs that are NEVER included (comma-separated), e.g. office IPs,
#            uptime monitors, the server's own public IP. Private IPs are always excluded.
# S4_BLOCKLIST_EXCLUDE=103.10.20.0/24, 198.51.100.7
# [OPTIONAL] Network owners (regex, case-insensitive) that are never blocked. Default: OMBUDSMAN.
#            Both can also be set from the Configuration page → Blocklist (overrides the value here).
# S4_BLOCKLIST_EXCLUDE_ORG=OMBUDSMAN


# ----------------------------------------------------------------------------------------------------
# 8. IMPORT FROM S3 ("Ingest & import" page)                                    (SECRET: AWS keys)
# ----------------------------------------------------------------------------------------------------
# [RECOMMENDED when logs come from a bucket] Allow list bucket -> prefixes (fill in your log bucket). {} = import off.
S4_IMPORT_BUCKETS={"simpel4-backup": ["k8s-logs/"]}
# [RECOMMENDED when import is used] READ-ONLY access key (see docs/10-user-guide.md: IAM policy). Note: AWS_* environment variables
#            already present on the server/container OVERRIDE the values in this file.
#            Empty is fine: just set them from the Configuration page (user menu → Configuration → AWS S3; stored in the account
#            database, effective immediately, overrides the value here), or paste temporary credentials on the Ingest & import page.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# [OPTIONAL] Only for temporary credentials (STS).
# AWS_SESSION_TOKEN=
# [OPTIONAL] Bucket region and per-import limits.
# S4_IMPORT_REGION=ap-southeast-3
# S4_IMPORT_MAX_OBJECTS=500
# S4_IMPORT_MAX_OBJECT_MB=1024
# S4_IMPORT_MAX_TOTAL_MB=5120
# S4_IMPORT_TIMEOUT_MINUTES=30
# [OPTIONAL] true = imported .log.gz files are extracted to .log in the inbox right away (larger on disk,
#            can be opened in an editor); false = stored as they are (.gz is still readable by the dashboard).
# S4_IMPORT_EXTRACT=true
# [OPTIONAL] AUTOMATIC SYNC: S3 parent folder containing YYYY-MM-DD folders. The server checks it periodically and
#            fetches + ingests NEW date folders by itself, without pasting a link. Must be covered by
#            S4_IMPORT_BUCKETS; the AWS keys above are required. Several prefixes: separate with commas. Empty = off.
#            Can also be set from the Configuration / Ingest & import page (written to this line).
# S4_S3_WATCH=s3://nama-bucket/k8s-logs/
# [OPTIONAL] false = automatic sync turned off without deleting the address above ("Turn off" button on the page).
# S4_S3_WATCH_ENABLED=true
# [OPTIONAL] Check interval (minutes); 0 = only via the "Check S3 now" button or cron.
# S4_S3_WATCH_MINUTES=60
# [OPTIONAL] Only folders dated within the last N days are fetched automatically (0 = the whole bucket history).
# S4_S3_WATCH_DAYS=30
# [OPTIONAL] Maximum new folders per check (newest first); the rest follow in the next checks.
# S4_S3_WATCH_MAX_FOLDERS=3
# [OPTIONAL] Synced folders dated >= today - N are re-checked every round (files that arrive late).
# S4_S3_WATCH_RECHECK_DAYS=1


# ----------------------------------------------------------------------------------------------------
# 8a. LOGS FROM KAFKA (Rancher: Cluster -> Tools -> Logging -> Kafka)               (SECRET: SASL password)
# ----------------------------------------------------------------------------------------------------
# Rancher messages {"log": original line, "kubernetes": {namespace_name, container_name, pod_name}, "time": …} are rewritten
# into the SAME folders as the S3 export (<date>/<namespace>/<service>/log_…log) in the inbox, then ingested
# periodically; nginx-ingress lines also drive the map in real time. Can be set from the Configuration page -> Kafka.
# [OPTIONAL] Broker address (host:port, commas for >1) and the topic Rancher writes to. Empty = Kafka not used.
# S4_KAFKA_BROKERS=10.10.1.5:9092
# S4_KAFKA_TOPIC=k8s-logs
# [OPTIONAL] false = consumer turned off without deleting the address above.
# S4_KAFKA_ENABLED=true
# [OPTIONAL] Consumer group (Kafka stores this group's read position; renaming = start reading again).
# S4_KAFKA_GROUP=monishield
# [OPTIONAL] Security: plaintext | sasl_plaintext | sasl_ssl | ssl. SASL: PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
#            (match the "SASL Configuration" in Rancher).
# S4_KAFKA_SECURITY=plaintext
# S4_KAFKA_SASL_MECHANISM=PLAIN
# S4_KAFKA_USERNAME=
# KAFKA_PASSWORD=
# [OPTIONAL] CA certificate (PEM) for ssl/sasl_ssl; empty = system CAs.
# S4_KAFKA_CA_FILE=
# [OPTIONAL] A new group starts reading from: earliest (all messages Kafka still keeps) | latest (only new ones).
# S4_KAFKA_OFFSET_RESET=earliest
# [OPTIONAL] Interval of the periodic ingest (minutes) for lines coming from Kafka.
# S4_KAFKA_INGEST_MINUTES=5


# ----------------------------------------------------------------------------------------------------
# 8b. NOTIFICATIONS: Telegram / Discord / email                           (SECRET: token, webhook, SMTP password)
# ----------------------------------------------------------------------------------------------------
# Easier via the Configuration page -> Notifications (written to these lines, with a "Send test" button). The server needs
# outbound access to api.telegram.org, discord.com, and/or the SMTP server. Messages NEVER contain IP addresses.
# [OPTIONAL] Telegram: enabled, bot token (@BotFather), group/channel chat ID (e.g. -1001234567890).
# S4_ALERT_TELEGRAM=false
# TELEGRAM_BOT_TOKEN=
# S4_ALERT_TELEGRAM_CHAT_ID=
# [OPTIONAL] Discord: enabled, channel webhook URL (https://discord.com/api/webhooks/…).
# S4_ALERT_DISCORD=false
# DISCORD_WEBHOOK_URL=
# [OPTIONAL] Email via SMTP: enabled, server, port, security (starttls | ssl | none), account, sender, recipients (comma-separated).
# S4_ALERT_EMAIL=false
# S4_SMTP_HOST=
# S4_SMTP_PORT=587
# S4_SMTP_SECURITY=starttls
# S4_SMTP_USERNAME=
# SMTP_PASSWORD=
# S4_SMTP_FROM=
# S4_SMTP_TO=
# [OPTIONAL] Events sent (comma-separated): spike, critical, ingest_failed, sync_failed, folder_missing, summary.
# S4_ALERT_EVENTS=spike,critical,ingest_failed,sync_failed,folder_missing
# [OPTIONAL] Message language (id | en), dashboard address for links in messages, hour (WIB) of the "today's folder has not arrived" check.
# S4_ALERT_LANG=id
# S4_DASHBOARD_URL=
# S4_ALERT_MISSING_HOUR=10


# ----------------------------------------------------------------------------------------------------
# 9. ENVIRONMENT VALUES OF THE MONITORED SYSTEM (hard-coded in the old system; change only if the infrastructure changes)
# ----------------------------------------------------------------------------------------------------
# [OPTIONAL] Destination point on the map = the server's public IP (resolved from api-simpel4.ombudsman.go.id).
# S4_SERVER_IP=103.170.104.228
# [OPTIONAL] Server point location when the IP database gives no city: [city, region, country, latitude, longitude].
# S4_SERVER_FALLBACK=["Jakarta", "Jakarta", "ID", -6.2, 106.82]
# [OPTIONAL] Upstream DNS monitored in the coredns log.
# S4_DNS_UPSTREAM=10.88.1.100
# [OPTIONAL] Ingress upstream name prefix that is stripped to keep module names short.
# S4_UPSTREAM_PREFIX=ombudsman-ombudsman-
# [OPTIONAL] Ingress upstream -> its public address (to show full URLs).
# S4_HOSTS={"om-be-simpel-loop-3000": "https://api-simpel4.ombudsman.go.id", "om-be-appsmanager-3000": "https://appsmanager-simpel4.ombudsman.go.id", "om-be-referensi-3000": "https://reference-simpel4.ombudsman.go.id", "om-be-report-3000": "https://report-simpel4.ombudsman.go.id", "om-fe-inhouse-3000": "https://simpel4.ombudsman.go.id", "cattle-system-rancher-80": "https://rancher-prd.ombudsman.go.id"}


# ----------------------------------------------------------------------------------------------------
# 10. EXTERNAL SERVICE ADDRESSES & DOWNLOAD SOURCES (previously written in the code; default = official addresses)
# ----------------------------------------------------------------------------------------------------
# [OPTIONAL] Change only when the server uses an internal mirror/proxy (e.g. no direct internet access).
#            Only public data files are downloaded; user IP addresses are NEVER sent to these addresses.
# [OPTIONAL] MaxMind GeoLite2; "{}" is replaced by the edition name (GeoLite2-City-CSV).
# S4_URL_MAXMIND=https://download.maxmind.com/geoip/databases/{}/download?suffix=zip
# [OPTIONAL] IP owner (ASN), iptoasn.com.
# S4_URL_IP2ASN=https://iptoasn.com/data/ip2asn-v4.tsv.gz
# [OPTIONAL] Map: land, country borders, province borders, country labels (Natural Earth); Indonesian region labels (GeoNames).
# S4_URL_LAND=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_land.geojson
# S4_URL_BORDERS=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_admin_0_boundary_lines_land.geojson
# S4_URL_PROVINCES=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_10m_admin_1_states_provinces.geojson
# S4_URL_COUNTRIES=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson
# S4_URL_GEONAMES=https://download.geonames.org/export/dump/ID.zip
# [OPTIONAL] Telegram API (e.g. via an internal proxy).
# S4_TELEGRAM_API=https://api.telegram.org
# [OPTIONAL] Maximum file age before it is downloaded again (days). GeoLite2 max. 30 (MaxMind license).
# S4_GEO_MAX_AGE_DAYS=7
# S4_ASN_MAX_AGE_DAYS=7
# S4_MAP_MAX_AGE_DAYS=3650
# [OPTIONAL] Abandoned browser folder upload sessions are cleaned up after N hours.
# S4_UPLOAD_SESSION_HOURS=6
